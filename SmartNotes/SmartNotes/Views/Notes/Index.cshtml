
@model IEnumerable<SmartNotes.Models.Note>

@{
    ViewData["Title"] = "My Notes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Notes</h2>

        <a asp-controller="Notes"
           asp-action="Create"
           class="btn btn-primary">
            Create Note
        </a>
    </div>
    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search notes by title..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Content</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var note in Model)
            {
                <tr>
                    <td>@note.Title</td>
                    <td>@note.Content</td>

                    <td>
                        <form asp-action="Summarize"
                              method="post"
                              class="d-inline">
                            <input type="hidden"
                                   name="id"
                                   value="@note.Id" />

                            <button type="submit"
                                    class="btn btn-info btn-sm">
                                Summarize with AI
                            </button>
                        </form>

                        <a asp-action="Edit"
                           asp-route-id="@note.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@note.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>